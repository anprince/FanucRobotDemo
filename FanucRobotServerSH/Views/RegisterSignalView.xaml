<UserControl x:Class="FanucRobotServerSH.Views.RegisterSignalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="1000"
             Background="#F5F5F5">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 行1：R 数值寄存器 + SR 字符串寄存器 -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- R -->
            <Border Style="{StaticResource CardBorder}" Grid.Column="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="数值寄存器 R"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="起始 "/>
                        <TextBox Width="60" Text="{Binding RStart}"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text=" 数量 "/>
                        <TextBox Width="60" Text="{Binding RCount}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="加载" Command="{Binding LoadRCommand}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding RItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                                    <TextBlock Text="{Binding IndexText}" Style="{StaticResource FieldLabel}" Width="46"/>
                                    <TextBox Width="90" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Style="{StaticResource DefaultButton}" Content="写"
                                            Command="{Binding DataContext.ApplyRCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Padding="8,3"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- SR -->
            <Border Style="{StaticResource CardBorder}" Grid.Column="1">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="字符串寄存器 SR"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="索引 "/>
                        <TextBox Width="60" Text="{Binding SrIndex}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="加载" Command="{Binding LoadSrCommand}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding SrItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                                    <TextBlock Text="{Binding IndexText}" Style="{StaticResource FieldLabel}" Width="46"/>
                                    <TextBox Width="240" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Style="{StaticResource DefaultButton}" Content="写"
                                            Command="{Binding DataContext.ApplySrCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Padding="8,3"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 行2：F 标志寄存器 + DI/DO 数字信号 -->
        <Grid Grid.Row="1" Margin="0,6,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- F -->
            <Border Style="{StaticResource CardBorder}" Grid.Column="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="标志寄存器 F"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="起始 "/>
                        <TextBox Width="60" Text="{Binding FStart}"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text=" 数量 "/>
                        <TextBox Width="60" Text="{Binding FCount}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="加载" Command="{Binding LoadFCommand}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding FItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                                    <TextBlock Text="{Binding IndexText}" Style="{StaticResource FieldLabel}" Width="42"/>
                                    <CheckBox IsChecked="{Binding IsOn, UpdateSourceTrigger=PropertyChanged}"
                                              Command="{Binding DataContext.ApplyFCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- DI/DO 信号 -->
            <Border Style="{StaticResource CardBorder}" Grid.Column="1">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="数字信号 DI / DO（输入区与输出区相互独立）"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource GroupHeader}" Text="DI（输入区 I）"/>
                            <ItemsControl ItemsSource="{Binding DiItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding IndexText}" IsChecked="{Binding IsOn}"
                                                  Command="{Binding DataContext.ToggleDiCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}" Margin="0,1,8,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource GroupHeader}" Text="DO（输出区 Q）"/>
                            <ItemsControl ItemsSource="{Binding DoItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding IndexText}" IsChecked="{Binding IsOn}"
                                                  Command="{Binding DataContext.ToggleDoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}" Margin="0,1,8,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 行3：AI/AO 模拟信号 -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource GroupHeader}" Text="模拟输入 AI"/>
                        <ItemsControl ItemsSource="{Binding AiItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,10,2">
                                        <TextBlock Text="{Binding IndexText}" Style="{StaticResource FieldLabel}" Width="32"/>
                                        <TextBox Width="70" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource GroupHeader}" Text="模拟输出 AO"/>
                        <ItemsControl ItemsSource="{Binding AoItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,10,2">
                                        <TextBlock Text="{Binding IndexText}" Style="{StaticResource FieldLabel}" Width="32"/>
                                        <TextBox Width="70" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Style="{StaticResource DefaultButton}" Content="写"
                                                Command="{Binding DataContext.SetAnalogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Padding="8,2"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="刷新信号"
                            Command="{Binding RefreshSignalsCommand}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
