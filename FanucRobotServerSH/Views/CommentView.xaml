<UserControl x:Class="FanucRobotServerSH.Views.CommentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="1000"
             Background="#F5F5F5">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 行1：注释编辑卡片 -->
        <Border Style="{StaticResource CardBorder}" Grid.Row="0" Margin="0,0,0,6">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="注释编辑 Comment（{前缀}[C{索引}]，每条 40 字）"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="类型 "/>
                    <ComboBox Width="70" ItemsSource="{Binding CommentTypes}"
                              SelectedItem="{Binding SelectedCommentType}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text=" 索引 "/>
                    <TextBox Width="60" Text="{Binding CommentIndex}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="加载" Command="{Binding LoadCommentCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="注释内容 "/>
                    <TextBox Width="320" Text="{Binding CommentValue, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Style="{StaticResource DefaultButton}" Content="写入"
                            Command="{Binding ApplyCommentCommand}" Margin="6,0,0,0" Padding="8,3"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 行2：注释列表卡片（按类型分组，Tab 切换 + 表格内直接编辑） -->
        <Border Style="{StaticResource CardBorder}" Grid.Row="1" Margin="0,6,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"
                        Content="刷新列表" Command="{Binding RefreshCommentsCommand}" Margin="0,0,0,8"/>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="本地注释列表（按类型切换，可直接编辑注释并保存，客户端写入后自动刷新）"/>
                    <!-- Tab 按类型分组切换 -->
                    <TabControl ItemsSource="{Binding CommentGroups}" MaxHeight="430">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TypeName}"/>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1"
                                        CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                    <StackPanel>
                                        <Border Background="#E8F0E8" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="6,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="变量" FontWeight="Bold" Foreground="#1B5E20"/>
                                                <TextBlock Grid.Column="1" Text="注释" FontWeight="Bold" Foreground="#1B5E20"/>
                                                <TextBlock Grid.Column="2" Text="操作" FontWeight="Bold" Foreground="#1B5E20" Width="64" TextAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="6,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                                   Foreground="#1B5E20" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="0,0,8,0"/>
                                                        <Button Grid.Column="2" Style="{StaticResource DefaultButton}" Content="写入"
                                                                Width="64"
                                                                Command="{Binding DataContext.ApplyRowCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                                CommandParameter="{Binding}" Padding="4,2"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
