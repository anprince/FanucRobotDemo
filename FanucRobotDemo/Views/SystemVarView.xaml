<UserControl x:Class="FanucRobotDemoSH.Views.SystemVarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="1000"
             Background="{StaticResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 读取 -->
            <Border Style="{StaticResource CardBorder}" Grid.Row="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="读取系统变量"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="变量名 "/>
                        <TextBox Width="250" Text="{Binding VarName}"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text=" 类型 "/>
                        <ComboBox Width="80" SelectedIndex="{Binding VarTypeIndex}">
                            <ComboBoxItem Content="INT"/><ComboBoxItem Content="REAL"/>
                            <ComboBoxItem Content="BOOL"/><ComboBoxItem Content="STRING"/>
                            <ComboBoxItem Content="POS"/>
                        </ComboBox>
                        <Button Style="{StaticResource PrimaryButton}" Content="读取" Command="{Binding ReadCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding VarResult}" FontWeight="Bold" Foreground="#673AB7" Margin="5,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 预设 -->
            <Border Style="{StaticResource CardBorder}" Grid.Row="1">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="常用系统变量 (点击读取)"/>
                    <WrapPanel>
                        <Button Style="{StaticResource DefaultButton}" Content="$SYSNAME" Width="90" Command="{Binding PresetCommand}" CommandParameter="$SYSNAME"/>
                        <Button Style="{StaticResource DefaultButton}" Content="$SS_ENB" Width="90" Command="{Binding PresetCommand}" CommandParameter="$SS_ENB"/>
                        <Button Style="{StaticResource DefaultButton}" Content="$MNUFRAME[1]" Width="100" Command="{Binding PresetCommand}" CommandParameter="$MNUFRAME[1]"/>
                        <Button Style="{StaticResource DefaultButton}" Content="$MOR_GRP[1].$ANGTOL[1]" Width="160" Command="{Binding PresetCommand}" CommandParameter="$MOR_GRP[1].$ANGTOL[1]"/>
                        <Button Style="{StaticResource DefaultButton}" Content="$SCRN_OP[1].$MAX_RPM" Width="150" Command="{Binding PresetCommand}" CommandParameter="$SCRN_OP[1].$MAX_RPM"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 写入 -->
            <Border Style="{StaticResource CardBorder}" Grid.Row="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="变量名 "/>
                    <TextBox Width="220" Text="{Binding WriteName}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text=" 值 "/>
                    <TextBox Width="60" Text="{Binding WriteValue}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="写入 (INT)" Command="{Binding WriteCommand}"/>
                </StackPanel>
            </Border>

            <!-- 批量组 -->
            <Border Style="{StaticResource CardBorder}" Grid.Row="3">
                <StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" Content="创建变量组并读取 ($ANGTOL + $MAX_RPM + $SYSNAME)"
                            Command="{Binding ReadGroupCommand}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding VarGroupResult}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
